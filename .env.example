# LLM
ANTHROPIC_API_KEY=your_anthropic_api_key

# Voice (speech-to-text + text-to-speech)
OPENAI_API_KEY=your_openai_api_key
# Optional: URL of a Hausa-capable TTS service (e.g. hosted MMS-TTS/Coqui model).
# Expects POST { text } -> returns raw mp3 bytes. Leave unset to skip Hausa audio replies.
HAUSA_TTS_URL=

# Data stores
DATABASE_URL=postgres://user:password@localhost:5432/alheri
REDIS_URL=redis://localhost:6379

# Server
PORT=3000
NODE_ENV=production

# WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=your_whatsapp_permanent_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=choose_a_verify_token

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Messenger (Meta Graph API)
MESSENGER_PAGE_TOKEN=your_page_access_token
MESSENGER_VERIFY_TOKEN=choose_a_verify_token
